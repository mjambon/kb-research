#!/usr/bin/env bash
#
# Print summaries of the 'run' results
#
set -eu -o pipefail

variants="
  orig
  stripped-comments
  stripped-comments-markdown
  cm+answer
  sitemap
"

for variant in $variants; do
  repo="skeletor-$variant"
  if ! [[ -e trace-"$repo"-10.jsonl ]]; then
    echo "Missing or incomplete run data for $repo"
    continue
  fi
  echo "===== repo: $repo ====="

  for i in `seq 1 10`; do
    cat trace-"$repo"-"$i".jsonl
  done | jq 'select(.type == "turn.completed")' > tmp.jsonl
  printf "Input tokens: "
  cat tmp.jsonl | jq '.usage.input_tokens' | jq -s add
  printf "  mean: "
  cat tmp.jsonl | jq '.usage.input_tokens' | jq -s 'add / length'
  printf "  stdev: "
  cat tmp.jsonl | jq '.usage.input_tokens' | jq -s '(add / length) as $mean | (map(. - $mean | . * .) | add) / (length - 1) | sqrt'
  printf "Cached input tokens: "
  cat tmp.jsonl | jq '.usage.cached_input_tokens' | jq -s add
  printf "Cache write input tokens: "
  cat tmp.jsonl | jq '.usage.cache_write_input_tokens' | jq -s add
  printf "Output tokens: "
  cat tmp.jsonl | jq '.usage.output_tokens' | jq -s add
  printf "Reasoning output tokens: "
  cat tmp.jsonl | jq '.usage.reasoning_output_tokens' | jq -s add

  printf "Duration (s): "
  grep real time-"$repo".txt | grep -oP '[0-9]+\.[0-9]+' | jq -s add

  for i in `seq 1 10`; do
    cat trace-"$repo"-"$i".jsonl
  done | jq 'select(.type == "item.started")' > tmp.jsonl
  printf "Tool calls: "
  cat tmp.jsonl | jq -r '.item.command' | wc -l

  for i in `seq 1 10`; do
    cat trace-"$repo"-"$i".jsonl | jq -r 'select(.type == "item.completed")' \
      | jq -sr 'last | .item.text' > answer-"$repo"-"$i".txt
  done
done
